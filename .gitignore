# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Environment variables (keep private, never commit)
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*

# Claude internal — but skills are shared, so keep them tracked.
# Note: `.claude/*` not `.claude/`, otherwise git never descends and the
# negation below is ignored.
.claude/*
!.claude/skills/

# Python
__pycache__/
*.pyc
.venv/

# calendarreport — generated documents and fetched event dumps
calendarreport/output/*.docx
calendarreport/samples/events_20*.json

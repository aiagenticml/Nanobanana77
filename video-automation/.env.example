# Required: Claude API key for ranker and script writer agents
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Reddit API credentials (for better rate limits)
# Without these, the scraper uses public JSON endpoints (no auth needed)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional: Pexels API key (for future video footage agent)
PEXELS_API_KEY=
